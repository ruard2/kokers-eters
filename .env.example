DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
APP_URL="https://jouw-railway-url.up.railway.app"
ADMIN_TOKEN="vervang-dit-door-een-sterk-admin-wachtwoord"
ADMIN_EMAIL="admin@example.nl"
CRON_SECRET="vervang-dit-door-een-sterke-cron-secret"
AUTO_GENERATE_ROUNDS="true"
AUTO_SEND_ROUNDS="false"
ALLOW_DEMO_SEED="false"
# Brevo transactionele e-mail — zelfde API-key en afzenderadres als Community Tools.
# BREVO_SENDER_EMAIL moet een geverifieerd adres zijn in het Brevo-account (bijv. no-reply@communitytools.online).
# MAILER_SENDER_NAME bepaalt de naam die ontvangers zien ("Van: Eters & Kokers").
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@communitytools.online"
MAILER_SENDER_NAME="Eters & Kokers"
# Optionele centrale login via Community Tools. Zonder de expliciete vlag
# blijven alle bestaande standalone routes exact werken.
COMMUNITY_TOOLS_SSO_ENABLED=false
COMMUNITY_TOOLS_URL=https://www.communitytools.online
COMMUNITY_TOOLS_CLIENT_ID=ct_shared_meals
COMMUNITY_TOOLS_CLIENT_SECRET=
COMMUNITY_TOOLS_SESSION_SECRET=
COMMUNITY_TOOLS_MANAGEMENT_ENABLED=false
COMMUNITY_TOOLS_MANAGEMENT_SECRET=
